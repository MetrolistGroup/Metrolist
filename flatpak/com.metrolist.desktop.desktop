[Desktop Entry]
Type=Application
Name=Metrolist
Comment=Stream and manage your YouTube Music library
Exec=com.metrolist.desktop %u
Icon=com.metrolist.desktop
Terminal=false
Categories=AudioVideo;Player;Music;
StartupWMClass=Metrolist
Keywords=music;player;youtube;streaming;
MimeType=x-scheme-handler/metrolist;x-scheme-handler/metrolist-auth;
