<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Metrolist"
    tools:ignore="UseAppTint"
    tools:targetApi="s">

    <FrameLayout
        android:id="@+id/widget_pill_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_pill_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_surface_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/widget_wide_artwork"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/widget_wide_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/album_art"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_wide_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/not_playing"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_wide_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/tap_to_play"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp" />

                <FrameLayout
                    android:id="@+id/widget_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:layoutDirection="ltr">

                    <ImageView
                        android:id="@+id/widget_progress_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_progress_track"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_progress_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_progress_clip"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_progress_stop"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_progress_stop"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/widget_progress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:max="1000"
                        android:progressDrawable="@drawable/widget_progress" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_prev_container"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/previous"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/widget_prev_background"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_circle_bg"
                        android:tint="@color/widget_secondary_container" />

                    <ImageView
                        android:id="@+id/widget_prev"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_skip_previous"
                        android:tint="@color/widget_on_secondary_container" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_play_pause_container"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:clickable="true"
                    android:contentDescription="@string/play"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/widget_play_background"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_circle_bg"
                        android:tint="@color/widget_primary" />

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_play"
                        android:tint="@color/widget_on_primary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_next_container"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/next"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/widget_next_background"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_circle_bg"
                        android:tint="@color/widget_secondary_container" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_skip_next"
                        android:tint="@color/widget_on_secondary_container" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
