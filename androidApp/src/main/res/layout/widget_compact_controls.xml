<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Widget.Metrolist"
    tools:ignore="UseAppTint"
    tools:targetApi="s">

    <FrameLayout
        android:id="@+id/widget_pill_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_pill_background"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_surface_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/widget_prev_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/previous"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_skip_previous"
                    android:tint="@color/widget_on_surface" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="@string/play"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_play_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_circle_bg"
                    android:tint="@color/widget_primary_container" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_on_primary_container" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/next"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_skip_next"
                    android:tint="@color/widget_on_surface" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
