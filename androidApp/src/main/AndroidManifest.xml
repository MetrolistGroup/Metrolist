            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.metrolist.android.quicksettings.MusicRecognizerTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_mic"
            android:label="@string/recognize_music"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name="com.metrolist.android.widget.WidgetActionReceiver"
            android:exported="false" />

        <activity
            android:name=".ui.screens.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash" />

        <activity
            android:name=".ui.screens.CrashLogsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:process=":crash">
            <intent-filter>
                <action android:name="com.metrolist.music.action.CRASH_LOGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
