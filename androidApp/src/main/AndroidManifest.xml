            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityGradient"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gradient"
            android:label="${appLabel}"
            android:targetActivity="com.metrolist.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="${appLabel}"
            android:targetActivity="com.metrolist.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityDynamic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="${appLabel}"
            android:targetActivity="com.metrolist.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <service
            android:name="com.metrolist.shared.youtube.playback.PoTokenService"
            android:exported="false"
            android:process=":potoken" />

        <service
            android:name="com.metrolist.android.playlistimport.AndroidPlaylistImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name="com.metrolist.android.playback.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name="com.metrolist.android.playback.MusicService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.metrolist.android.listentogether.ListenTogetherNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.metrolist.android.playback.DownloadNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.metrolist.android.update.CrashUpdateInstallReceiver"
            android:process=":crash"
            android:exported="false" />
        <receiver
            android:name="com.metrolist.android.update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name="com.metrolist.android.widget.MusicWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_music_player">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <receiver
            android:name="com.metrolist.android.widget.PlaylistWidgetReceiver"
            android:exported="true"
            android:label="@string/playlists">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
