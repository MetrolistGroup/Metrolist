        <activity-alias
            android:name=".MainActivityZenithBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_zenith_black"
            android:label="${appLabel}"
            android:targetActivity="com.metrolist.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityZenithWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_zenith_white"
            android:label="${appLabel}"
            android:targetActivity="com.metrolist.android.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
